<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.az9374.eduadmin.mapper.ClazzMapper">



    <!--    <select id="searchAll" resultType="com.az9374.eduadmin.pojo.Clazz">-->
<!--        select c.*,e.name master_name-->
<!--        from clazz c-->
<!--        left join emp e on c.master_id=e.id-->
<!--        order by c.update_time desc-->
<!--    </select>-->
<!--    动态查询-->
    <select id="searchBy" resultType="com.az9374.eduadmin.pojo.Clazz">
        select c.*,e.name master_name from clazz c
        left join emp e on c.master_id=e.id
        <where>
            <if test="name !=null and name!=''">
                c.name like concat('%',#{name},'%')</if>
            <if test="begin !=null and end !=null">
                and c.end_date between #{begin} and #{end}</if>
        </where>
        order by c.update_time desc
    </select>



<!--    3.增加班级-->
    <insert id="addClazz">
        insert into clazz(name, room, begin_date,
        end_date, master_id, subject, create_time,
        update_time)
        values
        (#{name},#{room},#{beginDate},#{endDate},
        #{masterId},#{subject}, #{createTime},
        #{updateTime} )
    </insert>

<!--    修改班级-->
    <update id="updateClazz">
        update clazz set name=#{name},room=#{room},begin_date=#{beginDate},
        end_date=#{endDate},master_id=#{masterId},subject=#{subject},update_time=#{updateTime}
        where id=#{id}
    </update>
</mapper>